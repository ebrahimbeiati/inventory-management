#!/bin/bash -xe\n\n# Variables passed from Terraform\nAWS_REGION=\"${aws_region}\"\nECR_CLIENT_IMAGE_URI=\"${ecr_client_image_uri}\"\nECR_SERVER_IMAGE_URI=\"${ecr_server_image_uri}\"\nPOSTGRES_USER=\"${postgres_user}\"\nPOSTGRES_DB=\"${postgres_db}\"\nAWS_ACCOUNT_ID=\"${aws_account_id}\"\n\n# Secrets Manager names (adjust if your secret names are different)\nSECRET_COGNITO_USER_POOL_ID_NAME=\"your_app/cognito_user_pool_id\" # Example: inventory-management/cognito_user_pool_id\nSECRET_COGNITO_CLIENT_ID_NAME=\"your_app/cognito_client_id\"\nSECRET_POSTGRES_PASSWORD_NAME=\"your_app/postgres_password\"\n\nAPP_DIR=\"/app\"\nENV_FILE=\"$APP_DIR/.env\"\nDOCKER_COMPOSE_FILE=\"$APP_DIR/docker-compose.yml\"\n\n# Update packages and install dependencies\nyum update -y\nyum install -y docker jq aws-cli\n\n# Install Docker Compose v2\nDOCKER_CONFIG=${DOCKER_CONFIG:-$HOME/.docker}\nmkdir -p $DOCKER_CONFIG/cli-plugins\ncurl -SL https://github.com/docker/compose/releases/download/v2.24.5/docker-compose-linux-x86_64 -o $DOCKER_CONFIG/cli-plugins/docker-compose\nchmod +x $DOCKER_CONFIG/cli-plugins/docker-compose\n\n# Start and enable Docker service\nsystemctl enable docker.service\nsystemctl start docker.service\nusermod -a -G docker ec2-user # Add ec2-user to docker group to run docker commands without sudo\n\n# Create app directory\nmkdir -p $APP_DIR\ncd $APP_DIR\n\n# Fetch secrets from AWS Secrets Manager and create .env file\necho \"Fetching secrets and creating .env file...\" > /tmp/user_data_status.txt\n\nCOGNITO_USER_POOL_ID=$(aws secretsmanager get-secret-value --secret-id \"$SECRET_COGNITO_USER_POOL_ID_NAME\" --region \"$AWS_REGION\" --query SecretString --output text | jq -r .)\nCOGNITO_CLIENT_ID=$(aws secretsmanager get-secret-value --secret-id \"$SECRET_COGNITO_CLIENT_ID_NAME\" --region \"$AWS_REGION\" --query SecretString --output text | jq -r .)\nPOSTGRES_PASSWORD=$(aws secretsmanager get-secret-value --secret-id \"$SECRET_POSTGRES_PASSWORD_NAME\" --region \"$AWS_REGION\" --query SecretString --output text | jq -r .)\n\nif [ -z \"$COGNITO_USER_POOL_ID\" ] || [ -z \"$COGNITO_CLIENT_ID\" ] || [ -z \"$POSTGRES_PASSWORD\" ]; then\n  echo \"Error: Failed to fetch one or more secrets from Secrets Manager.\" >> /tmp/user_data_status.txt\n  exit 1\nfi\n\n# Create .env file\ncat <<EOF > \"$ENV_FILE\"\n# --- Client Environment Variables ---\nNEXT_PUBLIC_API_URL=http://localhost:4000\nNEXT_PUBLIC_AWS_REGION=$AWS_REGION\nNEXT_PUBLIC_COGNITO_USER_POOL_ID=$COGNITO_USER_POOL_ID\nNEXT_PUBLIC_COGNITO_CLIENT_ID=$COGNITO_CLIENT_ID\n\n# --- Server Environment Variables ---\nDATABASE_URL=postgresql://$POSTGRES_USER:$POSTGRES_PASSWORD@db:5432/$POSTGRES_DB?schema=public\nAWS_REGION=$AWS_REGION\nCOGNITO_USER_POOL_ID=$COGNITO_USER_POOL_ID\nCOGNITO_CLIENT_ID=$COGNITO_CLIENT_ID\nNODE_ENV=production\nPORT=4000\n\n# --- Database Environment Variables ---\nPOSTGRES_USER=$POSTGRES_USER\nPOSTGRES_PASSWORD=$POSTGRES_PASSWORD\nPOSTGRES_DB=$POSTGRES_DB\nEOF\n\necho \".env file created successfully.\" >> /tmp/user_data_status.txt\n\n# Create docker-compose.yml\ncat <<EOF > \"$DOCKER_COMPOSE_FILE\"\nservices:\n  client:\n    image: $ECR_CLIENT_IMAGE_URI\n    ports:\n      - \"3001:3000\" # Host:Container\n    environment:\n      - NODE_ENV=production\n      - NEXT_PUBLIC_API_URL=http://server:4000 # Service discovery name\n      - NEXT_PUBLIC_AWS_REGION=\${AWS_REGION}\n      - NEXT_PUBLIC_COGNITO_USER_POOL_ID=\${COGNITO_USER_POOL_ID}\n      - NEXT_PUBLIC_COGNITO_CLIENT_ID=\${COGNITO_CLIENT_ID}\n    depends_on:\n      server:\n        condition: service_healthy\n    restart: unless-stopped\n    healthcheck:\n      test: [\"CMD\", \"curl\", \"-f\", \"http://localhost:3000\"]\n      interval: 30s\n      timeout: 10s\n      retries: 3\n      start_period: 60s\n    networks:\n      - app-network\n\n  server:\n    image: $ECR_SERVER_IMAGE_URI\n    ports:\n      - \"4000:4000\"\n    environment:\n      - NODE_ENV=production\n      - DATABASE_URL=\${DATABASE_URL}\n      - AWS_REGION=\${AWS_REGION}\n      - COGNITO_USER_POOL_ID=\${COGNITO_USER_POOL_ID}\n      - COGNITO_CLIENT_ID=\${COGNITO_CLIENT_ID}\n      - PORT=4000\n    depends_on:\n      db:\n        condition: service_healthy\n    restart: unless-stopped\n    healthcheck:\n      test: [\"CMD\", \"curl\", \"-f\", \"http://localhost:4000/health\"]\n      interval: 30s\n      timeout: 10s\n      retries: 3\n      start_period: 60s\n    networks:\n      - app-network\n\n  db:\n    image: postgres:14-alpine\n    environment:\n      - POSTGRES_USER=\${POSTGRES_USER}\n      - POSTGRES_PASSWORD=\${POSTGRES_PASSWORD}\n      - POSTGRES_DB=\${POSTGRES_DB}\n    volumes:\n      - postgres_data:/var/lib/postgresql/data\n    ports:\n      - \"5432:5432\"\n    restart: unless-stopped\n    healthcheck:\n      test: [\"CMD-SHELL\", \"pg_isready -U \${POSTGRES_USER}\"]\n      interval: 10s\n      timeout: 5s\n      retries: 5\n      start_period: 10s\n    networks:\n      - app-network\n\nnetworks:\n  app-network:\n    driver: bridge\n\nvolumes:\n  postgres_data:\n    driver: local\nEOF\n\necho \"docker-compose.yml created successfully.\" >> /tmp/user_data_status.txt\n\n# Login to ECR\necho \"Logging into ECR...\" >> /tmp/user_data_status.txt\naws ecr get-login-password --region \"$AWS_REGION\" | docker login --username AWS --password-stdin \"$AWS_ACCOUNT_ID.dkr.ecr.$AWS_REGION.amazonaws.com\"\n\n# Pull latest images (optional, as compose up should do it, but good for explicit update)\ndocker pull \"$ECR_CLIENT_IMAGE_URI\"\ndocker pull \"$ECR_SERVER_IMAGE_URI\"\n\n# Run Docker Compose\necho \"Starting Docker Compose services...\" >> /tmp/user_data_status.txt\n# Use the ec2-user's docker context after adding to group\n# Need to make sure docker compose can be found. If installed for user, might need full path or su - ec2-user -c \"...\"\n# Simpler: just run as root for now as systemctl services run as root anyway for docker. Docker client commands okay. \ndocker compose -f \"$DOCKER_COMPOSE_FILE\" up -d\n\necho \"User data script completed.\" >> /tmp/user_data_status.txt 